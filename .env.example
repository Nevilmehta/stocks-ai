# Copy this file to backend/.env and adjust values as needed.
# This file is committed as a template only - never put real secrets in it.

APP_ENV=development

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# If using the provided docker-compose.yml, this default matches it.
# If using a native local PostgreSQL install, update user/password/db accordingly.
DATABASE_URL=postgresql+psycopg2://stockai:stockai@localhost:5433/stockai

# Generate a strong random value for real use, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me

# Public self-registration is disabled by default - admin creates users instead.
ALLOW_REGISTRATION=false

# Optional: fixed passwords for the dev seed accounts (admin@example.com /
# demo@example.com). If left blank, scripts/seed_data.py generates random
# passwords and prints them once. Development use only.
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# --- Market data provider ---
# mock = built-in demo data (no external connection).
# real = real NSE price history via app/services/nse_bhavcopy.py (free, no API
#        key needed - MARKET_DATA_API_URL/KEY below are unused for it). Run
#        scripts/sync_real_market_data.py once to backfill history, then the
#        scheduler in app/scheduler.py keeps it current automatically.
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_URL=
MARKET_DATA_API_KEY=

# --- AI provider ---
# mock = deterministic rule-based research text (default, no external connection).
# gemini = Google Gemini.
# groq = Groq (OpenAI-compatible API, e.g. model "openai/gpt-oss-120b" - Groq's model
#        catalog changes over time, check https://console.groq.com/docs/models or
#        GET https://api.groq.com/openai/v1/models with your key for current names).
# custom = our own future AI model (added in a later phase).
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
CUSTOM_AI_URL=
CUSTOM_AI_API_KEY=

# --- Email (SMTP) ---
# Optional. If SMTP_HOST/USERNAME/PASSWORD are left blank, emails (e.g. the
# welcome email on account creation) are skipped and logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=StockAI
